# ---- core ----
LUMINA_ENV=development
# Signs session tokens. Production refuses to start with the development default or with
# anything shorter than 32 bytes (RFC 7518 §3.2). Generate one with:
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
LUMINA_SECRET_KEY=change-me-32-bytes-minimum-for-local-only

# ---- database ----
# Local: `make up` runs a private PostgreSQL cluster in .data/pg on port 55432, no Docker
# and no root required. Prod: Neon. `make up-docker` still brings up the container stack.
DATABASE_URL=postgresql+asyncpg://lumina@127.0.0.1:55432/lumina
TEST_DATABASE_URL=postgresql+asyncpg://lumina@127.0.0.1:55432/lumina_test

# ---- redis (pubsub, rate limits, circuit breakers — NOT the queue) ----
REDIS_URL=redis://localhost:6379/0

# ---- object storage ----
# "local" writes to LOCAL_MEDIA_ROOT on disk, so nothing external is needed to run the
# pipeline end to end. Set STORAGE=s3 to use R2 or MinIO instead.
STORAGE=local
LOCAL_MEDIA_ROOT=.data/media

S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=lumina-assets
S3_ACCESS_KEY_ID=lumina
S3_SECRET_ACCESS_KEY=lumina-dev-secret
S3_REGION=auto
# Public CDN base for delivered renders (Cloudflare in prod)
S3_PUBLIC_BASE_URL=http://localhost:9000/lumina-assets

# ---- providers ----
# Default is the FakeProvider: deterministic, instant, free. Never burn credits in tests.
PROVIDERS_ENABLED=fake
FAL_API_KEY=
REPLICATE_API_TOKEN=

# ---- intelligence ----
# Left unset, the SDK falls back to `ant auth login` profile credentials.
ANTHROPIC_API_KEY=

# Translation. A plain AI Studio key (aistudio.google.com/apikey) — NOT the service-account
# JSON that Cloud Speech and Vertex need. Preferred over Anthropic for translation because it
# measures better on Burmese, which is the language this product is hardest on.
GEMINI_API_KEY=
# Optional. Defaults to gemini-flash-latest; pin a version here if a release regresses.
GEMINI_MODEL=
PLANNER_MODEL=claude-opus-5

# ---- platform ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# ---- where this deployment lives ----
# PUBLIC_BASE_URL is where the API answers; the OAuth redirect URI is built from it, so it
# must match what each provider has registered, exactly, down to the trailing slash.
# WEB_BASE_URL is where the browser is sent back to after signing in, and must be the port
# the web app is actually served on — vite.config.ts pins it to 5173.
PUBLIC_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:5173

# ---- oauth ----
# Yours to register; they cannot ship in a repository. A greyed "NOT SET UP" button is an
# unregistered provider, not a fault. See OAUTH.md — GitHub takes about two minutes.
# Never commit the JSON the Google console hands you: keep the two values here instead.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# ---- speech to text ----
# "even-split" needs no model and no network; "whisper" needs `uv sync --extra asr` and
# downloads model weights on first use.
ASR_ENGINE=even-split

# ---- frontend (apps/web) ----
VITE_API_BASE_URL=http://localhost:8000

# Speech to text.
#
# Two engines, and which one runs is decided per language by the language pack — see
# `execution/transcribe.py`. Whisper is at or near the state of the art for English, Chinese,
# Japanese and Korean and costs about $0.04 an hour of audio on Groq, at roughly 200x real
# time. Its published Burmese word error rate is above 80%, so Burmese uses Scribe instead and
# will not fall back to Whisper: a bad ASR on a low-resource language returns confident fluent
# nonsense rather than failing, which is worse than no transcript at all.
#
# With neither set, the Subtitle and Clip lanes work from a subtitle file you attach, and
# refuse rather than invent when you do not attach one.
GROQ_API_KEY=
ELEVENLABS_API_KEY=

# Google Cloud Speech-to-Text v2. Its Chirp 2 is the only model at a major cloud that lists
# Burmese, and it descends from USM, which was trained for the long tail rather than having it
# fall out of a mostly-English corpus. Chirp 3 is newer and does *not* cover Burmese, so the
# model is chosen per language by the language pack.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=
GOOGLE_STT_LOCATION=global

# SeamlessM4T v2 (Meta, open weights), run locally.
#
# The one engine whose Burmese can be *measured* rather than taken on a vendor's word — which
# matters because the published figures are not comparable to each other. It needs torch and
# transformers, which usually live in their own conda environment rather than the service's,
# so point SEAMLESS_PYTHON at that interpreter; the model is run as a subprocess.
#
#   scripts/fetch_seamless.sh ~/models/seamless-m4t-v2-large
#   SEAMLESS_MODEL_DIR=/home/you/models/seamless-m4t-v2-large
#   SEAMLESS_PYTHON=/home/you/anaconda3/envs/yourenv/bin/python
#
# Seamless returns no timestamps — it is sequence-to-sequence. Captions are timed from where
# the speech actually is, by splitting on silence; see `execution/speech.py`.
SEAMLESS_MODEL_DIR=
SEAMLESS_PYTHON=

# Self-hosted Whisper instead of the hosted one. Needs `uv sync --extra asr` and downloads
# model weights on first use.
ASR_ENGINE=even-split
